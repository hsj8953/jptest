rules_version = '2';

// 카키토리 노트 보안 규칙
// 1) 아래 ADMIN_EMAIL_HERE 를 관리자 구글 이메일로 바꾸세요. (.env.local 의 NEXT_PUBLIC_ADMIN_EMAIL 과 같게)
// 2) Firebase 콘솔 > Firestore > 규칙 탭에 이 파일 내용을 통째로 붙여넣고 [게시]를 누르세요.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    function isAdmin() { return signedIn() && email() == "ADMIN_EMAIL_HERE".lower(); }
    function invited() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/access)
        && email() in get(/databases/$(database)/documents/config/access).data.emails;
    }
    function member() { return isAdmin() || invited(); }

    // 초대 목록: 로그인한 사람은 자기가 초대됐는지 확인만, 수정은 관리자만
    match /config/access {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // 승인 요청: 로그인한 사람은 자기 요청만 만들고 볼 수 있고, 목록 보기·처리는 관리자만
    match /requests/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == email()
        && request.resource.data.keys().hasOnly(['email', 'name', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 20;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // 곡 신청: 문서 이름은 유튜브 영상 ID. 신청한 사람과 관리자만 보고,
    // 같은 곡을 다른 친구가 또 신청하면 신청자 목록에 자기 이름만 더할 수 있어요.
    match /songRequests/{id} {
      // 아직 아무도 신청 안 한 곡인지 확인할 수 있게, 없는 문서는 누구나 확인 가능
      allow get: if isAdmin() || (member() && (resource == null || request.auth.uid in resource.data.requesterUids));
      allow list: if isAdmin() || (member() && request.auth.uid in resource.data.requesterUids);
      allow create: if member()
        && request.resource.data.requesterUids == [request.auth.uid]
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['youtubeId', 'title', 'artist', 'requesterUids', 'requesters', 'status', 'createdAt']);
      allow update: if isAdmin() || (member()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requesterUids', 'requesters'])
        && request.resource.data.requesterUids.hasAll(resource.data.requesterUids)
        && request.auth.uid in request.resource.data.requesterUids
        && request.resource.data.requesterUids.size() <= resource.data.requesterUids.size() + 1
        && request.resource.data.requesters.size() <= resource.data.requesters.size() + 1);
      allow delete: if isAdmin();
    }

    // 단어장 음성 설정(목소리)과 음성 파일: 멤버는 듣기만, 만드는 건 관리자만
    match /config/voice {
      allow read: if member();
      allow write: if isAdmin();
    }
    match /audio/{id} {
      allow read: if member();
      allow write: if isAdmin();
    }

    // 업데이트 소식: 멤버는 읽기, 관리자만 쓰기
    match /news/{id} {
      allow read: if member();
      allow write: if isAdmin();
    }

    // 곡: 멤버는 읽기, 관리자만 쓰기
    match /songs/{songId} {
      allow read: if member();
      allow write: if isAdmin();

      // 친구들 점수: 멤버는 모두 보고, 자기 것만 씀 (관리자는 곡 삭제 때 정리)
      match /scores/{uid} {
        allow read: if member();
        allow write: if member() && request.auth.uid == uid;
        allow delete: if isAdmin();
      }
    }

    // 내 진도 · 내가 쓴 답: 본인만
    match /users/{uid}/{document=**} {
      allow read, write: if member() && request.auth.uid == uid;
    }
  }
}
