# Firebase 콘솔 > 설정 > 프로젝트 설정 > 내 앱(웹) 의 firebaseConfig 값을 넣으세요.
# 이 파일을 복사해서 .env.local 로 이름을 바꾼 뒤 값을 채우면 돼요. (.env.local 은 GitHub에 안 올라가요)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 관리자(곡 등록 · 친구 초대를 하는 사람)의 구글 이메일
NEXT_PUBLIC_ADMIN_EMAIL=

# AI 한자 읽기 (Gemini). 서버에서만 쓰는 비밀 키라 NEXT_PUBLIC_ 을 붙이지 않아요.
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=
# (선택) 모델 이름. 비워두면 gemini-flash-latest
GEMINI_MODEL=
