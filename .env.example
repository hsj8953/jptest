# Firebase 콘솔 > 설정 > 프로젝트 설정 > 내 앱(웹) 의 firebaseConfig 값을 넣으세요.
# 이 파일을 복사해서 .env.local 로 이름을 바꾼 뒤 값을 채우면 돼요. (.env.local 은 GitHub에 안 올라가요)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 관리자(곡 등록 · 친구 초대를 하는 사람)의 구글 이메일
NEXT_PUBLIC_ADMIN_EMAIL=
